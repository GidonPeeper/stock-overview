# Copy to .env and fill in. .env is gitignored — never commit it.

# Trading 212: one READ-ONLY key pair per account (no ordering scope).
# The secret is shown only once at generation time — copy it immediately.
# Name each account T212_<NAME>_...; names containing "ISA" count as tax-free.
T212_INVEST_API_KEY=
T212_INVEST_API_SECRET=
T212_ISA_API_KEY=
T212_ISA_API_SECRET=
# A single account can also use the plain names (shown as "Trading212"):
# T212_API_KEY=
# T212_API_SECRET=
#
# Easier: add accounts in the app (Settings -> Add an account). Trading 212,
# Interactive Brokers, eToro, Bitvavo, Starling and Wise keys entered there are
# checked live and stored in data/connections.json (git-ignored, encrypted in
# the vault). Keys set here keep working next to them.

# Optional: Enable Banking bank links (EU bank balances). Easiest is to enter
# the application ID and choose the .pem file in Settings -> Add an account ->
# your bank -> Bank link. Or set them here (the key on one line with \n, or
# point ENABLEBANKING_KEY_FILE at the .pem file, e.g. a Render Secret File).
# ENABLEBANKING_APP_ID=
# ENABLEBANKING_PRIVATE_KEY=
# ENABLEBANKING_KEY_FILE=/etc/secrets/enablebanking.pem
# Only if the redirect URL built from the request is wrong (custom domain/proxy):
# ENABLEBANKING_REDIRECT_URL=https://example.com/enablebanking/callback

# Currency the dashboard starts in: EUR, GBP or USD (switch any time with the £/€ button).
DISPLAY_CURRENCY=GBP

# Optional: the day you became UK resident, if it was during the current tax
# year (split-year). The UK tax card only counts sales from this date.
# UK_RESIDENT_FROM=2026-08-18

# Tax-loss harvesting card (all optional). TAX_RESIDENCE: UK (default), US or NL.
# CGT_RATE in %: UK 24 for higher-rate taxpayers (18 inside the basic-rate band), US default 15.
# TAX_RESIDENCE=UK
# CGT_RATE=24
# HARVEST_MIN_LOSS_PCT=10
# HARVEST_MIN_LOSS=250
# UK losses from earlier tax years you reported to HMRC, in GBP:
# CGT_LOSSES_BROUGHT_FORWARD=0

# Login gate for the dashboard. Leave DASHBOARD_PASSWORD blank for local-only use
# (no login). Set it before exposing the app anywhere (hosting / tunnel).
DASHBOARD_USER=you
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# Optional: blends NewsAPI top business headlines into the Daily Brief
# (free key at https://newsapi.org). Works fine without it.
NEWSAPI_KEY=
