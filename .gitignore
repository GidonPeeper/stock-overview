# ============================================================================
#  PRIVATE — never committed. This is what keeps your data out of the public
#  repo. The app falls back to the *.sample files (which ARE committed) so the
#  project still runs for anyone who clones it.
# ============================================================================

# secrets: API keys + dashboard password
.env
config.toml

# everything the app saves in data/: statements, balances, keys (connections.json),
# your choices in Settings (settings.json), the encrypted vault and files it
# rebuilds itself. Only the made-up *.sample.* files are part of the repo.
data/*
!data/*.sample.*
# bank-link private keys, and backups downloaded into this folder
*.pem
*backup*.zip

# your own Claude Code / editor settings
.claude/settings.local.json

# python
__pycache__/
*.pyc
.venv/
venv/

# agent worktrees
.claude/worktrees/
