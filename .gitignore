# ============================================================================
#  PRIVATE — never committed. This is what keeps your data out of the public
#  repo. The app falls back to the *.sample files (which ARE committed) so the
#  project still runs for anyone who clones it.
# ============================================================================

# secrets: API keys + dashboard password
.env
config.toml

# your real broker data (statements / transcribed trades / bank balances)
data/degiro_account.csv
data/trades_trade_republic.json
data/income_trade_republic.json
data/trading212_statement.json
data/cash_accounts.json
data/watchlist.json
data/finances.json
# accounts added in Settings (API keys!) and positions read from CSV files
data/connections.json
data/manual_holdings.json
data/.*.tmp
# bank links in progress (single-use states, 30 min) and bank-link private keys
data/bank_link_states.json
*.pem

# generated at runtime (rebuilt automatically)
data/history.db
data/t212_instruments.json
data/sectors.json

# python
__pycache__/
*.pyc
.venv/
venv/
